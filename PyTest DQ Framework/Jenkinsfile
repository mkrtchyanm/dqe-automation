pipeline {
    agent any

    environment {
        DB_HOST = 'postgres'
        DB_PORT = '5432'
        DB_NAME = 'mydatabase'
    }

    stages {
        stage('Debug workspace and parquet output') {
            steps {
                sh '''
                    set -eux
                    pwd
                    ls -la
                    ls -la /parquet_data || true
                    find /parquet_data -maxdepth 2 -type f 2>/dev/null | head -50 || true
                '''
            }
        }

        stage('Install dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        set -eux
                        python3 -m venv .venv
                        . .venv/bin/activate
                        python -m pip install --upgrade pip
                        python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run DQ checks') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'POSTGRES_SECRET', usernameVariable: 'DB_USER', passwordVariable: 'DB_PASSWORD')]) {
                    dir('PyTest DQ Framework') {
                        sh '''
                            set -eux
                            . .venv/bin/activate
                            ls -la /parquet_data || true
                            python -m pytest tests -m parquet_data \
                                --db_host="$DB_HOST" \
                                --db_port="$DB_PORT" \
                                --db_name="$DB_NAME" \
                                --db_user="$DB_USER" \
                                --db_password="$DB_PASSWORD" \
                                --html=html_report/report.html
                        '''
                    }
                }
            }
        }

        stage('Publish report') {
            steps {
                dir('PyTest DQ Framework') {
                    sh 'ls -la html_report || true'
                    archiveArtifacts artifacts: 'html_report/**', fingerprint: true
                }
            }
        }
    }

    post {
        always {
            echo 'DQ pipeline execution completed.'
        }
        failure {
            echo 'DQ pipeline failed. Check the workspace and /parquet_data debug output above.'
        }
    }
}
