pipeline {
    agent any

    environment {
        DB_HOST = 'postgres'
        DB_PORT = '5432'
        DB_NAME = 'mydatabase'
        DB_USER = 'myuser'
        DB_PASSWORD = 'mypassword'
    }

    stages {
        stage('Debug workspace and parquet output') {
            steps {
                sh '''
                    set -eux
                    pwd
                    ls -la
                    ls -la /parquet_data || true
                    find /parquet_data -maxdepth 2 -type f 2>/dev/null | head -50 || true
                '''
            }
        }

        stage('Install dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        set -eux
                        python3 -m venv .venv
                        . .venv/bin/activate
                        python -m pip install --upgrade pip
                        python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run DQ checks') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        set +e
                        set -x
                        . .venv/bin/activate
                        mkdir -p html_report
                        echo "DB_HOST=${DB_HOST}"
                        echo "DB_PORT=${DB_PORT}"
                        echo "DB_NAME=${DB_NAME}"
                        echo "DB_USER=${DB_USER}"
                        ls -la /parquet_data || true

                        python -m pytest tests -m parquet_data \
                            --db_host="${DB_HOST}" \
                            --db_port="${DB_PORT}" \
                            --db_name="${DB_NAME}" \
                            --db_user="${DB_USER}" \
                            --db_password="${DB_PASSWORD}" \
                            -vv -s --maxfail=1 \
                            --html=html_report/report.html > pytest-output.log 2>&1
                        status=$?
                        echo "PYTEST_EXIT_CODE=${status}"
                        cat pytest-output.log
                        if [ "$status" -ne 0 ]; then
                            echo "Pytest failed with exit code $status"
                            exit "$status"
                        fi
                    '''
                }
            }
        }

        stage('Publish report') {
            steps {
                dir('PyTest DQ Framework') {
                    sh 'ls -la html_report || true; ls -la pytest-output.log || true'
                    archiveArtifacts artifacts: 'html_report/**, pytest-output.log', fingerprint: true
                }
            }
        }
    }

    post {
        always {
            echo 'DQ pipeline execution completed.'
        }
        failure {
            echo 'DQ pipeline failed. Check the workspace and /parquet_data debug output above.'
        }
    }
}
