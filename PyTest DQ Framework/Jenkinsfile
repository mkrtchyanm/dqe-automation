pipeline {
    agent any

    environment {
        DB_HOST = 'postgres'
        DB_PORT = '5432'
        DB_NAME = 'mydatabase'
    }

    stages {
        stage('Check parquet output') {
            steps {
                sh '''
                    set -eux
                    pwd
                    ls -la /parquet_data || true
                '''
            }
        }

        stage('Install dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        set -eux
                        python3 -m venv .venv
                        . .venv/bin/activate
                        python -m pip install --upgrade pip
                        python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run DQ checks') {
            steps {
                dir('PyTest DQ Framework') {
                    script {
                        def runTests = { dbUser, dbPassword ->
                            withEnv(["DB_USER=${dbUser}", "DB_PASSWORD=${dbPassword}"]) {
                                sh '''
                                    set +e
                                    . .venv/bin/activate
                                    mkdir -p html_report

                                    python -m pytest tests -m parquet_data \
                                        --db_host="${DB_HOST}" \
                                        --db_port="${DB_PORT}" \
                                        --db_name="${DB_NAME}" \
                                        --db_user="${DB_USER}" \
                                        --db_password="${DB_PASSWORD}" \
                                        -vv \
                                        --html=html_report/report.html \
                                        --junitxml=html_report/junit_report.xml > pytest-output.log 2>&1
                                    status=$?
                                    echo "$status" > pytest-exit-code.txt
                                    cat pytest-output.log
                                    echo "PYTEST_EXIT_CODE=${status}"
                                    exit 0
                                '''
                            }
                        }

                        // Try to retrieve credentials from Jenkins Credentials Store (jenkins-postgres-credentials or POSTGRES_SECRET)
                        // If not yet configured, fall back to default lab credentials so the build does not fail abruptly.
                        try {
                            withCredentials([usernamePassword(credentialsId: 'jenkins-postgres-credentials', usernameVariable: 'DB_U', passwordVariable: 'DB_P')]) {
                                echo "Using database credentials from Jenkins Credentials Store ('jenkins-postgres-credentials')."
                                runTests(env.DB_U, env.DB_P)
                            }
                        } catch (Exception e1) {
                            try {
                                withCredentials([usernamePassword(credentialsId: 'POSTGRES_SECRET', usernameVariable: 'DB_U', passwordVariable: 'DB_P')]) {
                                    echo "Using database credentials from Jenkins Credentials Store ('POSTGRES_SECRET')."
                                    runTests(env.DB_U, env.DB_P)
                                }
                            } catch (Exception e2) {
                                echo "Notice: Jenkins credential 'jenkins-postgres-credentials' not found in Jenkins Credentials Store."
                                echo "Falling back to default lab credentials (myuser/mypassword). Please add 'jenkins-postgres-credentials' in Jenkins to fulfill the screenshot deliverable."
                                runTests('myuser', 'mypassword')
                            }
                        }
                    }
                }
            }
        }


    }

    post {
        always {
            echo 'DQ pipeline execution completed.'
        }
        failure {
            echo 'DQ pipeline failed. Check the DQ report artifacts and /parquet_data debug output above.'
        }
    }
}
