pipeline {
    agent any

    environment {
        // Jenkins Credentials Store: "Username with password" credential, ID jenkins-postgres-credentials.
        // Exposes POSTGRES_SECRET_USR and POSTGRES_SECRET_PSW. No passwords in the repo.
        POSTGRES_SECRET = credentials('jenkins-postgres-credentials')
        DB_HOST = 'postgres'
        DB_PORT = '5432'
        DB_NAME = 'mydatabase'
    }

    stages {
        stage('Check parquet output') {
            steps {
                sh '''
                    set -eu
                    pwd
                    ls -la /parquet_data
                '''
            }
        }

        stage('Install dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        set -eux
                        python3 -m venv .venv
                        . .venv/bin/activate
                        python -m pip install --upgrade pip
                        python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run DQ checks') {
            steps {
                dir('PyTest DQ Framework') {
                    // Test failures must not stop the pipeline: the report is still generated and archived.
                    sh '''
                        set +e
                        . .venv/bin/activate
                        mkdir -p html_report

                        python -m pytest tests -m parquet_data \
                            --db_host="${DB_HOST}" \
                            --db_port="${DB_PORT}" \
                            --db_name="${DB_NAME}" \
                            --db_user="${POSTGRES_SECRET_USR}" \
                            --db_password="${POSTGRES_SECRET_PSW}" \
                            -vv \
                            --html=html_report/report.html \
                            --junitxml=html_report/junit_report.xml > pytest-output.log 2>&1
                        status=$?
                        echo "$status" > pytest-exit-code.txt
                        cat pytest-output.log
                        echo "PYTEST_EXIT_CODE=${status}"
                        exit 0
                    '''
                }
            }
        }

        stage('Generate report') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        set -eu
                        . .venv/bin/activate
                        python scripts/generate_report.py \
                            --junit html_report/junit_report.xml \
                            --output html_report/dq_summary.html \
                            --title "Data Quality Report (build ${BUILD_NUMBER})"
                        ls -la html_report
                    '''
                }
            }
        }

        stage('Publish report') {
            steps {
                // Archive first so artifacts are kept even if a later publisher step fails.
                archiveArtifacts artifacts: 'PyTest DQ Framework/html_report/**, PyTest DQ Framework/pytest-output.log', fingerprint: true, allowEmptyArchive: false
                junit allowEmptyResults: false, testResults: 'PyTest DQ Framework/html_report/junit_report.xml'
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'PyTest DQ Framework/html_report',
                    reportFiles: 'report.html,dq_summary.html',
                    reportName: 'HTML Test Report'
                ])
            }
        }

        stage('Evaluate DQ result') {
            steps {
                dir('PyTest DQ Framework') {
                    script {
                        // pytest exit codes: 0 = all passed, 1 = some checks failed (data defects), others = run/config error.
                        def code = readFile('pytest-exit-code.txt').trim()
                        if (code == '1') {
                            unstable('Data quality checks failed: mapping vs parquet mismatches. See the HTML report.')
                        } else if (code != '0') {
                            error("Pytest did not run correctly (exit code ${code}). See pytest-output.log.")
                        }
                    }
                }
            }
        }

    }

    post {
        always {
            // Safety net: if an earlier stage aborted before publishing, still keep whatever exists.
            archiveArtifacts artifacts: 'PyTest DQ Framework/html_report/**, PyTest DQ Framework/pytest-output.log', fingerprint: true, allowEmptyArchive: true
            echo 'DQ pipeline execution completed.'
        }
        failure {
            echo 'DQ pipeline failed. Check the DQ report artifacts and /parquet_data debug output above.'
        }
    }
}
